          "target_app_owner": "ACME 移动端团队（自有 App）",
          "authorized_by": "安全负责人 张三 / 工单 SEC-1024",
          "authorization_ref": "SEC-1024",
          "purpose": "验证客户端对 AP 身份的判定逻辑",
          "test_device": "iPhone12,1 / 测试机 SN-0001",
          "test_ap": "实验室 AP-BG-01"
        },
        "constraints": { "only_test_devices": true, "only_test_network": true, "no_production_targets": true },
        "scope": { "mode": "allowlist", "bundle_ids": ["com.example.bgtest"] }
      },
      "process": "com.example.bgtest",
      "expect": { "result": "ok", "field": null }
    },
