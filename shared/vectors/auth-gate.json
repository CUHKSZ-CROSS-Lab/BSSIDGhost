{
  "_comment": "授权闸与作用域判定的**语言中立测试向量**（对应测试矩阵 T8/T9）。iOS 的纯 C 核心（ios/hooks/BGGhostAuth.c）与 Android 的 Java 核心（R14）必须对同一份向量得出相同结论。",
  "_driven_by": "ios/tests/host/vector_auth.c 读 USV（\\x1f 分隔）流执行；ios/tests/host/run-vectors.sh 用 jq 把本文件转成该流。",
  "_protocol": "字段分隔符固定为 \\x1f。NULL 用 @null@，空串用 @empty@（本文件里空串只出现在「键名为空 / mode 为空」这类用例），无期望字段用 -。",
  "_safety_invariant": "这是本项目的安全闸：任何一条不满足都必须**拒绝启用**，并给出可定位的字段名。宁可误拒，不可误放。",
  "_case_shape": "每条用例自带完整配置（不依赖模板），便于 Android 端逐条独立消费。",
  "version": 1,
  "contract": {
    "_comment": "键名 / 字段名 / 判定结果码的稳定契约。两端实现都必须满足。",
    "auth_keys": ["target_app_owner", "authorized_by", "authorization_ref", "purpose", "test_device", "test_ap"],
    "field_names": ["authorization.target_app_owner", "authorization.authorized_by", "authorization.authorization_ref", "authorization.purpose", "authorization.test_device", "authorization.test_ap"],
    "result_codes": ["ok", "auth_missing", "auth_placeholder", "constraints", "scope_mode", "scope_empty", "process_scope"]
  },
  "field_set": [
    { "name": "未知键名 -> 拒绝（不静默忽略拼错的字段）", "key": "target_ap_owner", "value": "x", "ok": false },
    { "name": "键名为空 -> 拒绝", "key": "@empty@", "value": "x", "ok": false },
    { "name": "值为 NULL -> 拒绝", "key": "purpose", "value": null, "ok": false },
    { "name": "值长度 = 上限-1 -> 接受", "key": "target_app_owner", "value": { "repeat": "a", "times": 127 }, "ok": true },
    { "name": "值长度 = 上限 -> 拒绝（不截断）", "key": "target_app_owner", "value": { "repeat": "b", "times": 128 }, "ok": false },
    { "name": "合法键名 + 正常值 -> 接受", "key": "authorization_ref", "value": "SEC-1024", "ok": true }
  ],
  "bundle_add": [
    { "op": "add", "name": "BundleID 超长 -> 拒绝", "bundle_id": { "repeat": "c", "times": 128 }, "ok": false },
    { "op": "add", "name": "BundleID 为空 -> 拒绝", "bundle_id": "@empty@", "ok": false },
    { "op": "add", "name": "BundleID 为 NULL -> 拒绝", "bundle_id": null, "ok": false },
    { "op": "fill", "name": "容量内全部添加成功（BG_AUTH_MAX_BUNDLES 个）", "count": 8, "expect_added": 8, "count_after": 8 },
    { "op": "fill_overflow", "name": "超出容量 -> 拒绝，count 未越界", "count": 8, "ok": false, "count_after": 8 }
  ],
  "cases": [
