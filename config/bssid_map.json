{
  "_comment": "BSSID 映射表：真实值 -> 伪造值。仅替换 BSSID，SSID 刻意保持不变。",
  "_format": "BSSID 必须为 6 组大写十六进制、冒号分隔，需与目标接口返回格式一致",
  "enabled": false,
  "default": {
    "fake_bssid": "11:22:33:44:55:66"
  },
  "rules": [
    {
      "name": "example-office-wifi",
      "match": {
        "ssid": "Office_WiFi",
        "bssid": "AA:BB:CC:DD:EE:FF"
      },
      "replace": {
        "bssid": "11:22:33:44:55:66"
      },
      "enabled": false
    }
  ],
  "log": {
    "enabled": true,
    "path": "/var/mobile/Library/Logs/BSSIDGhost/ghost.log"
  }
}
